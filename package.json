{
  "name": "mathtest-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "MathTest AI — PDF matematika savollarini AI yordamida interaktiv testga aylantiruvchi platforma",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n mongo,backend,frontend -c magenta,blue,green --kill-others-on-fail \"node tmp-mongo-dev.mjs\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:mongo": "node tmp-mongo-dev.mjs",
    "setup": "npm install && npm run db:push && npm run seed",
    "db:push": "npm run db:push -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:studio": "npm run db:studio -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "serve": "node scripts/serve.mjs",
    "serve:tunnel": "node scripts/serve.mjs --tunnel",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "seed": "npm run seed -w backend",
    "e2e": "npm run e2e -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.3.0"
  },
  "overrides": {
    "canvas": "3.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "canvas@3.1.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "tesseract.js@5.1.1": true
  }
}
