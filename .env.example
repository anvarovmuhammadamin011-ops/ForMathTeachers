# ==========================================================
# MathTest AI — muhit o'zgaruvchilari
# Ushbu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# ==========================================================

# --- Ma'lumotlar bazasi (PostgreSQL) -----------------------
# Lokal dev uchun `npm run db:up` embedded PostgreSQL ni ishga tushiradi
# (port 5433, user postgres, parol postgres, baza mathtest).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mathtest?schema=public"

# --- Server -------------------------------------------------
PORT=4000
NODE_ENV=development
# Cookie xavfsizligi uchun productionda bir marta generatsiya qilingan maxfiy kalit:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="dev-only-change-me-in-production"
# Frontend manzili (CORS + cookie uchun)
CLIENT_ORIGIN="http://localhost:5173"

# --- AI (OpenAI-mos API) ------------------------------------
# Kalit bo'lmasa PDF konvertatsiyasi ishlamaydi va foydalanuvchiga
# aniq xabar ko'rsatiladi. Soxta AI javoblari ISHLATILMAYDI.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
# Matematika uchun kuchli model tavsiya etiladi: gpt-4.1 / gpt-5 / gemini-2.5-pro (OpenRouter orqali)
AI_MODEL="gpt-4o"
# Ixtiyoriy: skanerlangan sahifalar (rasm) uchun alohida model
AI_VISION_MODEL=""

# --- PDF / OCR ----------------------------------------------
# Skanerlangan PDF sahifalarini OCR qilish (tesseract.js mahalliy ishlaydi;
# birinchi ishga tushirishda til faylini yuklab oladi).
OCR_ENABLED=true
OCR_LANGUAGE="eng"
# Skanerlangan sahifalarni AI ga rasm sifatida yuborish
AI_SEND_PAGE_IMAGES=true

# --- Cheklovlar ---------------------------------------------
# Bitta PDF fayl uchun maksimal hajm (MB)
MAX_PDF_MB=30
# AI so'rovi uchun taym-aut (millisekund)
AI_TIMEOUT_MS=180000
